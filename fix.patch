+    def step_batch(self, batch, train: bool) -> Optional[torch.Tensor]:
+        # 1) unpack
+        x_num, x_cat = self._unpack(batch)
+        B = (x_num.shape[0] if x_num is not None else x_cat.shape[0])
+        L_num = (self.M.n_num_features or 0)
+        L_cat = (len(self.M.categories) if self.M.categories is not None else 0)
+        L_total = L_num + L_cat
+        device = self.device
+        dtype_num = (x_num.dtype if x_num is not None else torch.float32)
+\n+        # 2) selected mask (Bernoulli per feature)\n+        selected = (torch.rand(B, L_total, device=device) < float(self.cfg.mask_prob))\n+        if not selected.any():\n+            selected[torch.randint(0, B, (1,), device=device), torch.randint(0, L_total, (1,), device=device)] = True\n+\n+        # 3) actions (0=mask,1=keep,2=random)\n+        keep_p = float(self.cfg.keep_original_prob); rand_p = float(self.cfg.random_replace_prob)\n+        p_mask = max(0.0, 1.0 - keep_p - rand_p)\n+        probs = torch.tensor([p_mask, keep_p, rand_p], device=device)\n+        if probs.sum() <= 0: probs = torch.tensor([1.0, 0.0, 0.0], device=device)\n+        probs = probs / probs.sum()\n+        actions = torch.ones(B, L_total, device=device, dtype=torch.long)  # default keep\n+        sel_idx = torch.nonzero(selected, as_tuple=False)\n+        if sel_idx.numel() > 0:\n+            choices = torch.multinomial(probs, sel_idx.shape[0], replacement=True)\n+            for (b, f), a in zip(sel_idx.tolist(), choices.tolist()):\n+                actions[b, f] = int(a)\n+\n+        # 4) prepare numeric slices\n+        num_slices = []\n+        if x_num is not None and L_num > 0:\n+            off = 0\n+            for j in range(L_num):\n+                name = f\"num_{j:04d}\"\n+                Bj = int(self.M.spline_specs[name])\n+                num_slices.append((name, off, off + Bj))\n+                off += Bj\n+\n+        # 5) build rand_num / rand_cat only where needed\n+        rand_num = None\n+        if x_num is not None and L_num > 0:\n+            rand_num = x_num.clone()\n+            for b in range(B):\n+                for f in range(L_num):\n+                    if not selected[b, f] or actions[b, f] != 2:\n+                        continue\n+                    name, s, e = num_slices[f]\n+                    if self.cfg.numeric_random_mode == 'batch_shuffle' and B > 1:\n+                        j = int(torch.randint(0, B-1, (1,), device=device))\n+                        if j >= b: j += 1\n+                        rand_num[b, s:e] = x_num[j, s:e]\n+                    else:\n+                        stats = self.M.spline_stats.get(name, None)\n+                        if stats is not None and ('std' in stats):\n+                            sd = torch.as_tensor(stats['std'], device=device, dtype=dtype_num)\n+                            scale = float(self.cfg.numeric_noise_std_scale)\n+                            noise = torch.randn_like(sd) * (scale * torch.clamp(sd.mean(), min=1e-6))\n+                        else:\n+                            noise = torch.randn(e - s, device=device, dtype=dtype_num) * float(self.cfg.numeric_noise_std_scale)\n+                        rand_num[b, s:e] = x_num[b, s:e] + noise\n+\n+        rand_cat = None\n+        if x_cat is not None and L_cat > 0:\n+            rand_cat = x_cat.clone()\n+            for b in range(B):\n+                for j in range(L_cat):\n+                    f = L_num + j\n+                    if not selected[b, f] or actions[b, f] != 2:\n+                        continue\n+                    K = int(self.M.categories[j])\n+                    rand_cat[b, j] = torch.randint(0, max(1, K), (1,), device=device).item()\n+\n+        # 6) forward + loss\n+        preds, targets, specs = self.model(\n+            x_num, x_cat,\n+            selected=selected, actions=actions,\n+            rand_num=rand_num, rand_cat=rand_cat,\n+        )\n+        if preds is None:\n+            return None\n+        loss = self.model._compute_masked_losses(\n+            preds, targets, specs,\n+            eps=self.cfg.label_smoothing_eps,\n+            prior_mode=self.cfg.label_smoothing_prior,\n+            cat_priors=self.M.cat_priors_,\n+        )\n+        return loss
