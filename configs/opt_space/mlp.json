{
    "mlp": {
        "transform": {
            "num_cdf": {
                "weight_concentration_prior_type": [
                    "?categorical",
                    "dirichlet_process",
                    "dirichlet_process",
                    "dirichlet_distribution"
                ],
                "weight_threshold": [
                    "?loguniform",
                    1e-6,
                    1e-8,
                    1e-5
                ],
                "reg_covar": [
                    "?loguniform",
                    1e-6,
                    1e-7,
                    1e-5
                ],
                "dynamic_ks_thresh": [
                    "?uniform",
                    0.05,
                    0.01,
                    0.1
                ]
            }
        },
        "model": {
            "d_layers": [
                "$mlp_d_layers",
                1,
                8,
                64,
                2048
            ],
            "dropout": [
                "?uniform",
                0.0,
                0.0,
                0.5
            ]
        },
        "training": {
            "lr": [
                "loguniform",
                1e-05,
                0.01
            ],
            "weight_decay": [
                "?loguniform",
                0.0,
                1e-06,
                0.001
            ]
        },
        "general": {}
    }
}